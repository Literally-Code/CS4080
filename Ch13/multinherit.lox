class Doughnut {
  cook() {
    print "Fry until golden brown.";
    inner();
    print "Place in a nice box.";
  }
}

class TastyItem {
    eat() {
        print "Eat and enjoy";
    }
}

class BostonCream < Doughnut < TastyItem {
  cook() {
    print "Pipe full of custard and coat with chocolate.";
  }
}

var pastry = BostonCream();
pastry.cook();
pastry.eat();